<?xml version="1.0" encoding="utf-8"?>
<!-- Checked against: odoo/odoo 18.0, point_of_sale pos_payment_method form
     (view id point_of_sale.pos_payment_method_view_form: UNCONFIRMED). -->
<odoo>
    <record id="pos_payment_method_view_form_openbmt" model="ir.ui.view">
        <field name="name">pos.payment.method.form.openbmt</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='use_payment_terminal']" position="after">
                <field name="openbmt_box_address"
                       invisible="use_payment_terminal != 'openbmt'"
                       required="use_payment_terminal == 'openbmt'"/>
                <field name="openbmt_till_key" password="True"
                       invisible="use_payment_terminal != 'openbmt'"
                       required="use_payment_terminal == 'openbmt'"/>
                <field name="openbmt_counter"
                       invisible="use_payment_terminal != 'openbmt'"
                       required="use_payment_terminal == 'openbmt'"/>
            </xpath>
        </field>
    </record>
</odoo>
