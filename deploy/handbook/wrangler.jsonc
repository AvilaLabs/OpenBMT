{
  // Serves the handbook built by: mdbook build (output in dist/handbook).
  // Deploy: cd deploy/handbook && npx --yes wrangler@4 deploy --config wrangler.jsonc
  "name": "openbmt-handbook",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../dist/handbook",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "openbmt.avilalabs.org", "custom_domain": true }
  ]
}
