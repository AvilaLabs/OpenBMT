{
  // Serves openbmt.avilalabs.org: the demo at the root and the handbook at
  // /handbook/, both built into dist/site by scripts/site-build.sh.
  // Deploy: scripts/site-build.sh && cd deploy/handbook && npx --yes wrangler@4 deploy --config wrangler.jsonc
  "name": "openbmt-handbook",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../dist/site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "openbmt.avilalabs.org", "custom_domain": true }
  ]
}
